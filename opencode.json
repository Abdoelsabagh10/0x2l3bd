{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "hunter",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "python *",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "scripts/mcp/notion-bb.mjs",
      "effect": "ask"
    }
  ],
    "mcp": {
    "servers": {
      "burp": {
        "type": "local",
        "command": [
          "java",
          "-jar",
          "C:/Users/Abdo Elsabagh/OneDrive/Dokumente/mcp-proxy.jar",
          "--sse-url",
          "http://127.0.0.1:9876/"
        ]
      }
    }
  }
}
