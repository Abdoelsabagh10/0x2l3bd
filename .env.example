# Copy to .env and fill in real values. Never commit .env.
# Git Bash loader: set -a; [ -f .env ] && . ./.env; set +a

GITHUB_TOKEN=
PDCP_API_KEY=

# Workspace-managed Subfinder provider config.
SUBFINDER_PROVIDER_CONFIG=.config/subfinder/provider-config.yaml

# Notion MCP workspace tokens (read-only main / read-write MyBugBounty).
NOTION_TOKEN_MAIN=
NOTION_TOKEN_BB=
