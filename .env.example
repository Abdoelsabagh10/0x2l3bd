# Copy to .env and fill in real values. Never commit .env.
# Git Bash loader: set -a; [ -f .env ] && . ./.env; set +a

GITHUB_TOKEN=
PDCP_API_KEY=

# Workspace-managed Subfinder provider config.
SUBFINDER_PROVIDER_CONFIG=.config/subfinder/provider-config.yaml

# Notion MCP workspace tokens.
# NOTION_TOKEN_MAIN: read-only connection for personal methodology and notes.
#   Grant the integration read capability only, as a second layer behind
#   scripts/mcp/readonly-filter.mjs.
# NOTION_TOKEN_BB: read/write connection for bug bounty notes and findings.
NOTION_TOKEN_MAIN=
NOTION_TOKEN_BB=

# Optional: override the .env path used by the Notion bridges.
# NOTION_ENV_FILE=

# Optional OTPKit paid providers. OTPKit works without keys using free,
# PUBLIC, shared inboxes and numbers, which are visible to other people.
# Never use public shared numbers for real or sensitive accounts.
# FIVESIM_API_KEY=
# SMSPOOL_API_KEY=
